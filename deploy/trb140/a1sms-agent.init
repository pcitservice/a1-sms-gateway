#!/bin/sh /etc/rc.common
# OpenWrt procd service for the A1 SMS Gateway agent.
# Install at /etc/init.d/a1sms-agent, then:
#   /etc/init.d/a1sms-agent enable
#   /etc/init.d/a1sms-agent start
#
# procd will keep it running and restart on crash.

USE_PROCD=1
START=95
STOP=10

PROG=/opt/a1sms/gateway_agent.py
LOG=/var/log/a1sms-agent.log

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 "$PROG"
    procd_set_param respawn 5 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /opt/a1sms/config.json
    procd_close_instance
}

reload_service() {
    stop
    start
}
